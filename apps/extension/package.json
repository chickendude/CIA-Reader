{
  "name": "@ciareader/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Primeran subtitle-mining browser extension (Firefox-first, Chrome-compatible).",
  "scripts": {
    "build": "node scripts/build.mjs both",
    "build:firefox": "node scripts/build.mjs firefox",
    "build:chrome": "node scripts/build.mjs chrome",
    "dev:firefox": "node scripts/build.mjs firefox --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@types/firefox-webext-browser": "^120.0.4",
    "@vitest/coverage-v8": "^2.1.3",
    "esbuild": "^0.24.0",
    "eslint": "^9.12.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.8.1",
    "vitest": "^2.1.3"
  }
}
