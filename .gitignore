# deps
node_modules/
.pnpm-store/

# builds
.svelte-kit/
build/
dist/
.vite/

# python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# coverage
coverage/
.coverage
coverage.lcov
*.coverage.*

# env / secrets
.env
.env.local
.env.*.local

# editor swap files (a stray .env.swp once leaked a key into a commit)
*.swp
*.swo

# logs / os
*.log
.DS_Store

# ide
.vscode/
.idea/

# claude code worktrees / scratch
.claude/worktrees/

# upstream dictionary dumps fetched by scripts/fetch-dictionary-sources.sh
# (T-3.10). The repo never carries the raw artifacts — tests use small
# checked-in fixtures, prod runs the fetch step on demand.
apps/web/data/dictionaries/*/raw.*
apps/web/data/dictionaries/*/raw_*
# DSAL scrape cache (scripts/scrape-dsal.ts): raw HTML responses + manifest.
apps/web/data/dictionaries/*/scrape/

# Playwright (e2e tests)
apps/web/e2e/.auth/
apps/web/playwright-report/
apps/web/test-results/
apps/web/playwright/.cache/

# GCP service-account key for Vision OCR (never commit)
infra/secrets/
